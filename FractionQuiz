import java.util.Random;
import java.util.Scanner;

/**
 * A quiz game that asks random fraction arithmetic questions until the user types "quit".
 */
public class FractionQuiz
{
    public static void main(String[] args)
    {
        Scanner in = new Scanner(System.in);
        Random rand = new Random();
        String[] operators = {"+", "-", "*", "/"};

        int correct = 0;
        int answered = 0;

        System.out.println("Let the Fraction Quiz Begin. Answers should be in lowest terms. Good luck!");

        while (true)
        {
            // Two random fractions (default constructor) and a random operator
            Fraction a = new Fraction();
            Fraction b = new Fraction();
            String op = operators[rand.nextInt(operators.length)];

            Fraction answer;
            if (op.equals("+"))
            {
                answer = a.add(b);
            }
            else if (op.equals("-"))
            {
                answer = a.subtract(b);
            }
            else if (op.equals("*"))
            {
                answer = a.multiply(b);
            }
            else
            {
                answer = a.divide(b);
            }

            System.out.println();
            System.out.print(a + " " + op + " " + b + " = ");

            // Keep asking until we get "quit" or something that reads as a Fraction
            Fraction guess = null;
            boolean quit = false;
            while (guess == null && !quit)
            {
                if (!in.hasNextLine())
                {
                    quit = true;     // input ended: treat like quit
                    break;
                }
                String input = in.nextLine().trim();
                if (input.equalsIgnoreCase("quit"))
                {
                    quit = true;
                }
                else
                {
                    try
                    {
                        guess = new Fraction(input);
                    }
                    catch (NumberFormatException e)
                    {
                        System.out.print("Please type a fraction like 3/4, or quit: ");
                    }
                }
            }

            if (quit)
            {
                break;   // the question the user quits on is not scored
            }

            answered++;
            if (guess.equals(answer))
            {
                correct++;
                System.out.println("Correct!");
            }
            else
            {
                System.out.println("Wrong, the answer was " + answer);
            }
        }

        System.out.println();
        if (answered == 0)
        {
            System.out.println("You didn't answer any questions!");
        }
        else
        {
            Fraction score = new Fraction(correct, answered);   // not reduced on purpose
            long percent = Math.round(score.toDouble() * 100);
            System.out.println("You answered " + score + " correctly, for a score of "
                + percent + " percent!");
        }
    }
}